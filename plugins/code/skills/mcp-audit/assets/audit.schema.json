{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/mcp-server-audit/audit.schema.json",
  "title": "MCP server audit",
  "description": "Shape of mcp-audit.json as written by scripts/score.py.",
  "type": "object",
  "required": [
    "rubric_version",
    "server",
    "score",
    "metrics",
    "changes"
  ],
  "properties": {
    "rubric_version": {
      "type": "string"
    },
    "server": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "language": {
          "type": "string"
        },
        "sdk": {
          "type": "string"
        },
        "sdk_version": {
          "type": "string"
        },
        "transports": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "protocol_version": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "extraction": {
          "enum": [
            "runtime",
            "static"
          ]
        },
        "catalogs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "score": {
      "type": "object",
      "required": [
        "overall",
        "raw",
        "grade",
        "capped",
        "cap_reasons",
        "advisory",
        "categories"
      ],
      "properties": {
        "overall": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "raw": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "grade": {
          "enum": [
            "A",
            "B",
            "C",
            "D",
            "F"
          ]
        },
        "capped": {
          "type": "boolean"
        },
        "cap_reasons": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "advisory": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/checkId"
          }
        },
        "categories": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "title",
              "weight",
              "effective_weight",
              "earned",
              "checks"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "title": {
                "type": "string"
              },
              "weight": {
                "type": "number"
              },
              "effective_weight": {
                "type": "number"
              },
              "earned": {
                "type": "number"
              },
              "checks": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/checkResult"
                }
              }
            }
          }
        }
      }
    },
    "metrics": {
      "type": [
        "object",
        "null"
      ]
    },
    "changes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/change"
      }
    }
  },
  "$defs": {
    "checkId": {
      "type": "string",
      "pattern": "^[A-Z]{3,4}-\\d+$"
    },
    "checkResult": {
      "type": "object",
      "required": [
        "id",
        "title",
        "category",
        "weight",
        "per_tool",
        "result",
        "score",
        "note",
        "cap_triggered",
        "spec_violation",
        "version_gated"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/checkId"
        },
        "title": {
          "type": "string"
        },
        "category": {
          "type": "string"
        },
        "weight": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3
        },
        "per_tool": {
          "type": "boolean"
        },
        "result": {
          "enum": [
            "pass",
            "partial",
            "fail",
            "na",
            "advisory"
          ]
        },
        "score": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        },
        "advisory_score": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "confidence": {
          "enum": [
            "verified",
            "static",
            null
          ]
        },
        "note": {
          "type": "string"
        },
        "cap_triggered": {
          "type": "boolean"
        },
        "spec_violation": {
          "type": "boolean"
        },
        "version_gated": {
          "type": "boolean"
        },
        "normalized_from": {
          "enum": [
            "pass",
            "partial",
            "fail"
          ],
          "description": "Agent-reported result before score.py derived it from the per-tool score."
        },
        "requires_version": {
          "type": "string",
          "description": "Minimum protocol version for a version-gated check."
        }
      }
    },
    "change": {
      "type": "object",
      "required": [
        "id",
        "priority",
        "title",
        "check_ids",
        "locations",
        "evidence",
        "change",
        "effort",
        "breaking",
        "score_delta",
        "clears_caps"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^CHG-\\d{3,}$"
        },
        "priority": {
          "enum": [
            "P0",
            "P1",
            "P2"
          ]
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "check_ids": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/checkId"
          }
        },
        "tools": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "locations": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "file"
            ],
            "properties": {
              "file": {
                "type": "string",
                "minLength": 1
              },
              "line": {
                "type": "integer",
                "minimum": 1
              }
            }
          }
        },
        "evidence": {
          "type": "string",
          "minLength": 1
        },
        "change": {
          "type": "string",
          "minLength": 1
        },
        "patch": {
          "type": "string"
        },
        "effort": {
          "enum": [
            "S",
            "M",
            "L"
          ]
        },
        "breaking": {
          "type": "boolean"
        },
        "score_delta": {
          "type": "number",
          "minimum": 0,
          "description": "Upper-bound gain in the uncapped score if every referenced check fully passed."
        },
        "clears_caps": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/checkId"
          }
        }
      }
    }
  }
}
